<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Encspect.Tests</RootNamespace>
    <!-- BoundarySamples holds a function pointer, one of the paths DecodingBoundaryTests must find. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Encspect.Cli\Encspect.Cli.csproj" />
    <ProjectReference Include="..\..\src\Encspect.Host\Encspect.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Thread pool threads do not exit when idle: an exiting thread's arrays in the shared array pools would leave the heap with no event
         for the memory tests' accounting of pooled bytes (PoolAccounting). Dedicated threads still take theirs with them. -->
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.ThreadsToKeepAlive" Value="-1" />
  </ItemGroup>
</Project>
