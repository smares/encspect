<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- The trim, AOT and single-file analyzers run in every ordinary build of the CLI's projects, so a construct NativeAOT cannot
         compile (reflection over unknown types, dynamic code) fails the build, with TreatWarningsAsErrors, before a publish does.
         The CLI is published with NativeAOT; docs/development.md, "NativeAOT". -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
