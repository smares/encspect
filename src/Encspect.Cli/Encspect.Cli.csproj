<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>encspect</AssemblyName>
    <RootNamespace>Encspect.Cli</RootNamespace>
    <!-- Releases are published with NativeAOT (-p:PublishAot=true, one native executable per platform; docs/development.md, "NativeAOT").
         Every trim and AOT warning of that publish is an error (TreatWarningsAsErrors of Directory.Build.props), and each one is shown
         on its own instead of one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <!-- The JIT build (dotnet build and run, the tests, the cross-check scripts) still runs on the runtime's tiering, which NativeAOT
       has none of: the decoders' loops start in tier 0 and the instrumented tier of dynamic PGO, and an analysis of a few seconds is over
       before the default tiering has replaced them (docs/development.md, "CLI runtime settings"). Nothing here applies to a NativeAOT
       executable, which is compiled optimized once and has no tiers. -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Encspect.Host\Encspect.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Encspect.Tests" />
  </ItemGroup>
</Project>
