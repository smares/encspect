<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Encspect.Gui.Views.AboutWindow"
        Title="About Encspect"
        Width="420" SizeToContent="Height" CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="32,24" Spacing="6">
    <TextBlock Text="Encspect" FontSize="20" FontWeight="SemiBold" />
    <SelectableTextBlock Name="VersionText" Classes="secondary" TextWrapping="Wrap" />
    <TextBlock Name="DescriptionText" Margin="0,8,0,0" TextWrapping="Wrap" />
    <TextBlock Name="CopyrightText" Classes="secondary" TextWrapping="Wrap" />
    <TextBlock Name="NoticesText" Classes="secondary" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Name="NoticesButton" Content="Third-Party Notices" Padding="16,5" />
      <Button Name="CloseButton" Content="Close" IsDefault="True" IsCancel="True" Padding="20,5" />
    </StackPanel>
  </StackPanel>
</Window>
