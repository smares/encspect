<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>wma-decode-probe</AssemblyName>
    <RootNamespace>WmaDecodeProbe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- CA1416: the registry and COM calls are Windows only, and the program runs only there. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableComInterfaceGenerator>false</EnableComInterfaceGenerator>
  </PropertyGroup>
</Project>
